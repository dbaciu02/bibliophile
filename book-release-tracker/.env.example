# Copy to api/.env for local development. Never commit real values.
# Local dev only — staging/production secrets live in the host's secret store.

DATABASE_URL=postgres://app:app@localhost:5432/booktracker
TEST_DATABASE_URL=postgres://app:app@localhost:5432/booktracker_test
PORT=3000

# Set by CI at build time; shown by /healthz (requirement D4)
GIT_SHA=dev

# Entra ID (filled in after docs/entra-id-setup.md; used from step 3 on)
ENTRA_TENANT_ID=
ENTRA_API_CLIENT_ID=
