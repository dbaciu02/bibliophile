# Template for every environment variable the project uses. NO REAL VALUES.
#
#   Local dev:          copy to api/.env   (and web/.env for the VITE_ values)
#   Staging/production: set these in the host's secret store / CI secrets.
#
# Each variable is marked [secret] or [not secret]. Secrets are described in
# docs/secrets.md (purpose, where stored, how to rotate) — never their values.

# --- API: server -------------------------------------------------------------
NODE_ENV=development                 # [not secret] development | test | production
PORT=3000                            # [not secret]
GIT_SHA=dev                          # [not secret] set by CI; shown by /healthz (D4)

# --- API: database -----------------------------------------------------------
# The local values below are the throwaway Docker dev database. Staging and
# production have their own, different passwords (D3).
DATABASE_URL=postgres://app:app@localhost:5433/booktracker            # [secret outside local dev]
TEST_DATABASE_URL=postgres://app:app@localhost:5433/booktracker_test  # [local/CI only]

# --- API: Entra ID token validation (step 3) ---------------------------------
ENTRA_TENANT_ID=                     # [not secret] Directory (tenant) ID
ENTRA_API_CLIENT_ID=                 # [not secret] booktracker-api Application (client) ID

# --- API: Google Books (step 4) ----------------------------------------------
GOOGLE_BOOKS_API_KEY=                # [secret] Google Cloud API key, restricted to Books API
# GOOGLE_BOOKS_BASE_URL=http://127.0.0.1:9   # [not secret] uncomment ONLY to simulate Google being down

# --- API: MCP server (step 7) ------------------------------------------------
PUBLIC_BASE_URL=http://localhost:3000  # [not secret] public URL of the API; must be https in production (MCP metadata, Host check)
# MCP_APP_HTML=../mcp-app/dist/release-calendar.html  # [not secret] built MCP App; this default works with npm run build:mcp-app

# --- Web (Vite exposes only VITE_* to the browser — never put a secret here) --
VITE_ENTRA_TENANT_ID=                # [not secret]
VITE_ENTRA_CLIENT_ID=                # [not secret] booktracker-web Application (client) ID
VITE_ENTRA_API_CLIENT_ID=            # [not secret] used to build scope names api://<id>/...
