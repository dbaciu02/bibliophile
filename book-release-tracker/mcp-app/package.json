{
  "name": "@book-release-tracker/mcp-app",
  "private": true,
  "type": "module",
  "description": "MCP App (F13): the interactive release calendar shown inside MCP hosts by the show_release_calendar tool.",
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "host": "vite --config vite.host.config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^5.1.0"
  }
}
